# Copy this file to .env and fill in your keys. Never commit .env.
SECRET_KEY=change-me
YARN_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: exact, case-sensitive YarnGPT voice ids per language.
# Run `python tools/list_voices.py` to see the live catalogue.
YARN_VOICE_EN=
YARN_VOICE_YO=
YARN_VOICE_IG=
YARN_VOICE_HA=
YARN_VOICE_PCM=

# Fake heartbeat/temperature data until your sensor hardware is connected.
SIMULATE_SENSORS=true
# Sample medicines + 24h of sample vitals on first run (set false for real use).
SEED_DEMO_DATA=true
# If set, hardware must send this value in the X-Device-Key header.
DEVICE_API_KEY=

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
